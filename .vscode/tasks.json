{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Generate fictional data",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": [
        "-m",
        "ar_copilot.generate"
      ],
      "problemMatcher": []
    },
    {
      "label": "Run AR Copilot (Ollama)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": [
        "-m",
        "streamlit",
        "run",
        "app.py",
        "--server.address",
        "127.0.0.1",
        "--browser.gatherUsageStats",
        "false"
      ],
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": [
        "-m",
        "pytest",
        "-q"
      ],
      "problemMatcher": []
    },
    {
      "label": "Evaluate offline fixtures",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": [
        "-m",
        "ar_copilot.evaluate",
        "--mode",
        "demo"
      ],
      "problemMatcher": []
    },
    {
      "label": "Evaluate Ollama with checkpoints",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": [
        "-m",
        "ar_copilot.evaluate",
        "--mode",
        "ollama",
        "--resilient",
        "--pace",
        "0",
        "--max-attempts",
        "1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Regenerate saved Ollama summary",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": [
        "scripts/publish_results.py",
        "reports/ollama/resilient_20261010T222850202032Z.json"
      ],
      "problemMatcher": []
    }
  ]
}
