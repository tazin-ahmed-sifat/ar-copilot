{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Generate fictional data",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {"command": "${workspaceFolder}/.venv/Scripts/python.exe"},
      "args": ["-m", "ar_copilot.generate"],
      "problemMatcher": []
    },
    {
      "label": "Run AR Copilot",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {"command": "${workspaceFolder}/.venv/Scripts/python.exe"},
      "args": ["-m", "streamlit", "run", "app.py"],
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {"command": "${workspaceFolder}/.venv/Scripts/python.exe"},
      "args": ["-m", "pytest", "-q"],
      "problemMatcher": []
    },
    {
      "label": "Evaluate offline fixtures",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {"command": "${workspaceFolder}/.venv/Scripts/python.exe"},
      "args": ["-m", "ar_copilot.evaluate", "--mode", "demo"],
      "problemMatcher": []
    }
  ]
}
